---
import BaseLayout from './BaseLayout.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, pubDate, author, readingTime } = post.data;

const authorData = {
  Dany: {
    fullName: 'Dra. Daniela Tapia',
    bio: 'Cirujano-dentista y co-fundadora de Kolibri Dental.',
    initials: 'DT',
    image: '/dany.jpg',
  },
  Kolibri: {
    fullName: 'Equipo Kolibri Dental',
    bio: 'Análisis y recursos sobre gestión financiera para clínicas dentales en Chile.',
    initials: 'K',
    image: null,
  },
  Florian: {
    fullName: 'Florian Witt',
    bio: 'Co-fundador de Kolibri Dental. Especialista en controlling y finanzas, consultor SAP & Workday. Aplica lógica financiera corporativa a la gestión de clínicas dentales.',
    initials: 'FW',
    image: '/florian.jpg',
  },
};

const a = authorData[author];

const formattedDate = pubDate.toLocaleDateString('es-CL', {
  year: 'numeric', month: 'long', day: 'numeric'
});

const siteUrl = 'https://blog.getkolibri.app';
const postUrl = `${siteUrl}/${post.slug}/`;
---

<BaseLayout title={title} description={description}>

  <!-- Article structured data (GEO + SEO) -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": title,
    "description": description,
    "datePublished": pubDate.toISOString(),
    "author": {
      "@type": author === 'Dra. Daniela Tapia' ? 'Person' : 'Organization',
      "name": a.fullName,
    },
    "publisher": {
      "@type": "Organization",
      "name": "Kolibri Dental",
      "url": "https://getkolibri.app"
    },
    "mainEntityOfPage": postUrl,
    "inLanguage": "es-CL"
  })} />

  <a href="/" class="back-link">← Volver al blog</a>

  <article class="article-wrap">
    <header class="article-header">
      <div class="article-meta">
        <span class={`author-badge ${author.toLowerCase()}`}>{a.fullName}</span>
        <span class="article-date">{formattedDate}</span>
        {readingTime && <span class="reading-time">{readingTime} min de lectura</span>}
      </div>
      <h1>{title}</h1>
      <p class="article-description">{description}</p>
    </header>

    <div class="article-body">
      <slot />
    </div>

    <div class="author-box">
      {a.image
  ? <img src={a.image} alt={a.fullName} class="author-avatar-img" />
  : <div class="author-avatar">{a.initials}</div>
}
      <div class="author-info">
        <h3>{a.fullName}</h3>
        <p>{a.bio}</p>
      </div>
    </div>
  </article>

  <div class="cta-block container">
    <h2>¿Tu clínica también pierde utilidad sin saber por qué?</h2>
<p>Kolibri Dental calcula automáticamente el costo real de cada tratamiento. Sin planillas, sin suposiciones.</p>
<a href="https://getkolibri.app" class="cta-btn">Conocer Kolibri →</a>
  </div>
<!--
  SECCIÓN DE COMENTARIOS — Supabase (sin login externo)
  =======================================================
  Reemplaza completamente el bloque anterior en BlogPost.astro
  por este. Ya tiene tu SUPABASE_URL y ANON_KEY si los habías
  puesto antes — revisa que sigan correctos abajo.
-->

<div class="comments-section container" id="comments-root" data-slug={post.slug}>
  <h3 class="comments-title">Comentarios</h3>

  <div id="comments-list" class="comments-list">
    <p class="comments-loading">Cargando comentarios...</p>
  </div>

  <form id="comment-form" class="comment-form">
    <div class="comment-form-row">
      <input type="text" id="comment-name" placeholder="Tu nombre" required maxlength="100" />
      <input type="email" id="comment-email" placeholder="Email (opcional, no se publica)" />
    </div>
    <textarea id="comment-text" placeholder="Escribe tu comentario..." required maxlength="2000" rows="4"></textarea>
    <input type="text" id="comment-website" name="website" class="honeypot" tabindex="-1" autocomplete="off" />
    <button type="submit" id="comment-submit">Enviar comentario</button>
    <p id="comment-status" class="comment-status"></p>
  </form>
  <p class="comments-note">Los comentarios se revisan antes de publicarse.</p>
</div>

<style>
  .comments-section {
    max-width: 720px;
    margin: 3rem auto 0;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }
  .comments-title {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 600;
    margin-bottom: 1.25rem;
    color: var(--carbon);
  }
  .comments-list { margin-bottom: 2rem; display: flex; flex-direction: column; gap: 0.75rem; }
  .comments-loading, .comments-empty {
    font-size: 0.88rem;
    color: var(--carbon-soft);
  }

  /* ── Comment item ── */
  .comment-item {
    display: flex;
    gap: 0.75rem;
    background: white;
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 1rem 1.1rem;
  }
  .comment-avatar {
    flex-shrink: 0;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--verde-pale);
    color: var(--verde);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.95rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .comment-content { flex: 1; min-width: 0; }
  .comment-header {
    display: flex;
    align-items: baseline;
    gap: 0.55rem;
    margin-bottom: 0.3rem;
    flex-wrap: wrap;
  }
  .comment-author {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--carbon);
  }
  .comment-date {
    font-size: 0.74rem;
    color: var(--carbon-soft);
    font-weight: 400;
  }
  .comment-date::before {
    content: '·';
    margin-right: 0.55rem;
    color: var(--border);
  }
  .comment-body {
    font-size: 0.88rem;
    color: var(--carbon-soft);
    line-height: 1.6;
  }

  /* ── Form ── */
  .comment-form {
    background: white;
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 1.25rem;
  }
  .comment-form-row {
    display: flex;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }
  .comment-form input[type="text"],
  .comment-form input[type="email"],
  .comment-form textarea {
    width: 100%;
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 0.6rem 0.75rem;
    font-family: var(--font-body);
    font-size: 0.88rem;
    background: var(--crema);
    color: var(--carbon);
  }
  .comment-form textarea { margin-bottom: 0.75rem; resize: vertical; }
  .comment-form input:focus, .comment-form textarea:focus {
    outline: none;
    border-color: var(--verde);
  }
  .honeypot { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
  #comment-submit {
    background: var(--verde);
    color: white;
    border: none;
    border-radius: 6px;
    padding: 0.6rem 1.4rem;
    font-size: 0.88rem;
    font-weight: 500;
    cursor: pointer;
    transition: background 0.15s;
  }
  #comment-submit:hover { background: var(--verde-light); }
  #comment-submit:disabled { opacity: 0.6; cursor: not-allowed; }
  .comment-status {
    font-size: 0.82rem;
    margin-top: 0.6rem;
    min-height: 1.2em;
  }
  .comment-status.success { color: var(--verde); }
  .comment-status.error { color: #c0503f; }
  .comments-note {
    font-size: 0.78rem;
    color: var(--carbon-soft);
    margin-top: 0.75rem;
  }

  @media (max-width: 640px) {
    .comment-form-row { flex-direction: column; }
  }
</style>

<script>
  const SUPABASE_URL = 'https://fxpocaaextezoirfkayh.supabase.co';
  const SUPABASE_ANON_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImZ4cG9jYWFleHRlem9pcmZrYXloIiwicm9sZSI6ImFub24iLCJpYXQiOjE3Njc5MTgwNTIsImV4cCI6MjA4MzQ5NDA1Mn0.rr2WDj-msf8QoAwHx4sQf8EO9api4UZv-uRPW6HXIWk';

  const root = document.getElementById('comments-root');
  const slug = root?.getAttribute('data-slug') || '';
  const listEl = document.getElementById('comments-list');
  const form = document.getElementById('comment-form') as HTMLFormElement;
  const statusEl = document.getElementById('comment-status');
  const submitBtn = document.getElementById('comment-submit') as HTMLButtonElement;

  function escapeHtml(str: string) {
    const div = document.createElement('div');
    div.textContent = str;
    return div.innerHTML;
  }

  function formatDate(iso: string) {
    return new Date(iso).toLocaleDateString('es-CL', { year: 'numeric', month: 'short', day: 'numeric' });
  }

  async function loadComments() {
    try {
      const res = await fetch(
        `${SUPABASE_URL}/rest/v1/blog_comments?post_slug=eq.${encodeURIComponent(slug)}&approved=eq.true&order=created_at.desc`,
        {
          headers: {
            apikey: SUPABASE_ANON_KEY,
            Authorization: `Bearer ${SUPABASE_ANON_KEY}`,
          },
        }
      );
      const comments = await res.json();

      if (!Array.isArray(comments) || comments.length === 0) {
        listEl!.innerHTML = '<p class="comments-empty">Aún no hay comentarios. Sé el primero en escribir uno.</p>';
        return;
      }

      listEl!.innerHTML = comments
        .map((c: any) => {
          const initial = escapeHtml(c.author_name.trim().charAt(0).toUpperCase());
          return `
          <div class="comment-item">
            <div class="comment-avatar">${initial}</div>
            <div class="comment-content">
              <div class="comment-header">
                <span class="comment-author">${escapeHtml(c.author_name)}</span>
                <span class="comment-date">${formatDate(c.created_at)}</span>
              </div>
              <div class="comment-body">${escapeHtml(c.comment_text)}</div>
            </div>
          </div>
        `;
        })
        .join('');
    } catch (err) {
      listEl!.innerHTML = '<p class="comments-empty">No se pudieron cargar los comentarios.</p>';
    }
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const honeypot = (document.getElementById('comment-website') as HTMLInputElement).value;
    if (honeypot) return;

    const name = (document.getElementById('comment-name') as HTMLInputElement).value.trim();
    const email = (document.getElementById('comment-email') as HTMLInputElement).value.trim();
    const text = (document.getElementById('comment-text') as HTMLTextAreaElement).value.trim();

    if (!name || !text) return;

    submitBtn.disabled = true;
    statusEl!.textContent = '';
    statusEl!.className = 'comment-status';

    try {
      const res = await fetch(`${SUPABASE_URL}/rest/v1/blog_comments`, {
        method: 'POST',
        headers: {
          apikey: SUPABASE_ANON_KEY,
          Authorization: `Bearer ${SUPABASE_ANON_KEY}`,
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          post_slug: slug,
          author_name: name,
          author_email: email || null,
          comment_text: text,
          approved: false,
        }),
      });

      if (!res.ok) throw new Error('failed');

      statusEl!.textContent = 'Gracias, tu comentario fue enviado y se publicará después de ser revisado.';
      statusEl!.className = 'comment-status success';
      form.reset();
    } catch (err) {
      statusEl!.textContent = 'Hubo un problema al enviar tu comentario. Intenta de nuevo.';
      statusEl!.className = 'comment-status error';
    } finally {
      submitBtn.disabled = false;
    }
  });

  loadComments();
</script>
</BaseLayout>
